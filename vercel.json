{
  "version": 2,
  "builds": [
    {
      "src": "public_library_mym/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "static/admin/(.*)",
      "dest": "staticfiles/admin/$1"
    },
    {
      "src": "(.*)",
      "dest": "public_library_mym/wsgi.py"
    }
  ]
}
